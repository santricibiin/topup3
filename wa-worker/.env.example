# Konfigurasi WA worker. Jangan commit nilai sebenarnya.

# Port HTTP worker. Default 3002 — beda dari Next (3000) dan WA gateway lama (3001).
PORT=3002

# Bind address. 127.0.0.1 = hanya bisa diakses dari mesin yang sama.
# JANGAN expose ke 0.0.0.0 di production tanpa firewall ketat.
HOST=127.0.0.1

# API key untuk auth dari Next.js. Generate sekali, simpan di sini & di
# settings DB Next.js. Format bebas — saya pakai pola yang sama dengan
# gateway lama supaya consistency.
WAOTP_WORKER_KEY=waotp_local_change_me_to_random_64_chars

# Folder tempat Baileys simpan auth state (multi-file). Path relatif ke
# folder wa-worker/. Restart aman selama folder ini intact.
AUTH_DIR=./auth

# Default OTP behavior
OTP_LENGTH=6
OTP_EXPIRES_SECONDS=300
OTP_MAX_ATTEMPTS=5
